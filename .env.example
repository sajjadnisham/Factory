# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/mensstore?schema=public"

# --- Application ----------------------------------------------------------
# Public origin of the site, used for SEO metadata, sitemap and Open Graph.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Secret used to sign customer and admin session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-characters"

# --- Product storage (the STOCK folder) -----------------------------------
# Which StorageProvider implementation to use: "local" | "google-drive"
STORAGE_PROVIDER="local"

# local provider: absolute or project-relative path to the STOCK folder
LOCAL_STOCK_PATH="./stock"

# google-drive provider: service account with read-only access to the STOCK
# folder. Share the STOCK folder with the service account email as Viewer —
# this keeps access least-privilege (read-only, one folder).
GOOGLE_DRIVE_STOCK_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Private key with literal \n escapes, wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- OTP / SMS ------------------------------------------------------------
# Which OtpSender implementation to use: "console" | "http"
# "console" logs a masked notice and is for local development only.
OTP_PROVIDER="console"
OTP_LENGTH="4"
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_SENDS_PER_HOUR="5"

# "http" provider: generic REST SMS gateway. Configure once the real Maldivian
# SMS provider is chosen; the request body is JSON {to, message}.
SMS_HTTP_ENDPOINT=""
SMS_HTTP_API_KEY=""
SMS_SENDER_ID=""

# --- Payment --------------------------------------------------------------
# Which PaymentProvider implementation to use.
# "manual" = bank transfer / cash on delivery, verified by an admin.
# "gateway" = real online gateway, configured once the provider is supplied.
PAYMENT_PROVIDER="manual"
PAYMENT_GATEWAY_ENDPOINT=""
PAYMENT_GATEWAY_MERCHANT_ID=""
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# --- Admin ----------------------------------------------------------------
# Used once by `npm run admin:create` to create the first admin user.
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""

# --- Optional CDN host for product images ---------------------------------
NEXT_PUBLIC_IMAGE_HOST=""
